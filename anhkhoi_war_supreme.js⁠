}

function loadDb() {
  try {
    if (existsSync(DB_FILE)) {
      const data = JSON.parse(readFileSync(DB_FILE, "utf8"));
      return Object.assign(initDb(), data);
    }
  } catch {}
  return initDb();
}

function saveDb(d) {
  try { writeFileSync(DB_FILE, JSON.stringify(d, null, 2)); } catch {}
}

