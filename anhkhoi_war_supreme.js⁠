async function handleUpdate(update) {
  if (!update.message) return;
  const m = update.message;
  const chatId = m.chat.id;
  const uid = String(m.from ? m.from.id : 0);
  const text = (m.text || m.caption || "").trim();

  // 1. XỬ LÝ NẠP FILE .TXT (DEDUPLICATION TUYỆT ĐỐI)
  if (m.document && (text.startsWith("/napfile") || m.caption?.includes("/napfile"))) {
    if (!isAdm(uid)) return bot.sendMessage(chatId, "❌ Chỉ Thống Soái mới có quyền nạp kho ngôn!");
    if (!m.document.file_name.toLowerCase().endsWith(".txt")) {
      return bot.sendMessage(chatId, "💡 Vui lòng gửi định dạng file `.txt`!");
    }

    const waitMsg = await bot.sendMessage(chatId, "⏳ Đang tải file và tiến hành khử trùng lặp (Hash Deduplication)...");
    const fileInfo = await bot.getFile(m.document.file_id);

    if (fileInfo && fileInfo.ok && fileInfo.result.file_path) {
      const rawText = await bot.downloadFileText(fileInfo.result.file_path);
      if (rawText) {
        const lines = rawText.split(/\r?\n/);
        const currentSet = new Set(memoryCorpus);
        const beforeCount = currentSet.size;

        for (const line of lines) {
          const cleaned = line.replace(/^\d+[\.\)\]]\s*/, "").trim();
          if (cleaned.length >= 3) currentSet.add(cleaned);
        }

        const added = currentSet.size - beforeCount;
        memoryCorpus = [...currentSet].sort();
        saveCorpus(memoryCorpus);

        return bot.sendMessage(
          chatId,
          `✅ *NẠP FILE THÀNH CÔNG!*\n` +
          `📄 Tệp: \`${m.document.file_name}\`\n` +
          `📥 Đã quét: \`${lines.length}\` dòng\n` +
          `✨ Thêm mới (loại trùng tuyệt đối): \`${added}\` câu\n` +
          `📊 Tổng kho từ vựng hiện tại: \`${memoryCorpus.length}\` câu`
        );
