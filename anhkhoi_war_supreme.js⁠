    time: formatVNDateTime(),
    userId: String(userId),
    userName: userName || "Ẩn danh",
    command: command || "Không rõ",
    chat: chatTitle || "Chat Riêng (DM)",
    ts: Date.now()
  };
  db.logs = db.logs || [];
  db.logs.unshift(logItem);
  if (db.logs.length > 60) db.logs = db.logs.slice(0, 60);
  saveDb(db);
}

