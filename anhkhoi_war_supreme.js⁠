    db.delay = v;
    saveDb(db);
    bot.sendMessage(chatId, `✅ Đã thiết lập vận tốc: *${v}s/đòn*`);
  }

  // KHO NGÔN TỪ
  else if (cmd === "/themngon") {
    if (!isAdm(uid)) return bot.sendMessage(chatId, "❌ Chỉ Thống Soái mới có quyền nạp kho ngôn!");
    const p = text.split(/\s+/);
    if (p.length < 2) return bot.sendMessage(chatId, "💡 Cú pháp: `/themngon Câu 1 | Câu 2 | Câu 3`");

    const rawEntries = text.substring(p[0].length).trim().split("|");
    const currentSet = new Set(memoryCorpus);
    let added = 0;

    for (const item of rawEntries) {
      const cleaned = item.replace(/^\d+[\.\)\]]\s*/, "").trim();
      if (cleaned.length >= 3 && !currentSet.has(cleaned)) {
        currentSet.add(cleaned);
        added++;
      }
    }

    memoryCorpus = [...currentSet].sort();
    saveCorpus(memoryCorpus);
    bot.sendMessage(chatId, `✅ *ĐÃ THÊM THÀNH CÔNG:*\n➕ Thêm mới: \`${added}\` câu\n📚 Tổng kho: \`${memoryCorpus.length}\` câu`);
  } else if (cmd === "/kho") {
    const sample = memoryCorpus.slice(0, 5).map(x => `• ${x}`).join("\n");
    bot.sendMessage(
      chatId,
      `📊 *KHO TỪ VỰNG ANH KHÔI*\n` +
      `Tổng số câu độc nhất: \`${memoryCorpus.length}\` câu\n\n` +
      `🔍 *Mẫu trích xuất:*\n${sample || "Chưa có dữ liệu"}\n\n` +
      `💡 Nạp thêm bằng: \`/themngon\` hoặc gửi file \`.txt\` kèm \`/napfile\``
    );
  } else if (cmd === "/xoangon") {
    if (!isAdm(uid)) return bot.sendMessage(chatId, "❌ Quyền hạn bị từ chối!");
    const p = text.split(/\s+/);
    if (p.length < 2) return bot.sendMessage(chatId, "💡 Cú pháp: `/xoangon <từ khóa>`");
    const kw = p.slice(1).join(" ").toLowerCase();
    const before = memoryCorpus.length;
    memoryCorpus = memoryCorpus.filter(x => !x.toLowerCase().includes(kw));
    const removed = before - memoryCorpus.length;
    saveCorpus(memoryCorpus);
    bot.sendMessage(chatId, `🗑 Đã xóa sạch \`${removed}\` câu chứa từ khóa \`${kw}\`. Còn lại: \`${memoryCorpus.length}\` câu.`);
  }

  // ĐỊA BÀN & QUẢN TRỊ
  else if (cmd === "/dondep" || cmd === "/quetgon") {
    const p = text.split(/\s+/);
    let count = Math.min(Math.max(parseInt(p[1], 10) || 20, 1), 100);
    const startId = m.message_id;
    let deleted = 0;
    for (let i = 0; i <= count; i++) {
      try {
        await bot.deleteMessage(chatId, startId - i);
        deleted++;
      } catch {}
    }
    const n = await bot.sendMessage(chatId, `🧹 Đã thanh trừng sạch sẽ *${deleted}* tin nhắn!`);
    setTimeout(() => { if (n && n.result) bot.deleteMessage(chatId, n.result.message_id); }, 3000);
  } else if (cmd === "/camkhau") {
    const { target } = resolveTarget(m);
    if (!target || isAdm(target)) return bot.sendMessage(chatId, "💡 Cú pháp: `/camkhau @user [phút]`");
    const p = text.split(/\s+/);
    const mins = parseInt(p[2], 10) || 0;
    const until = mins > 0 ? Math.floor(Date.now() / 1000) + mins * 60 : undefined;
    await bot.restrictChatMember(chatId, Number(target), { can_send_messages: false }, until);
    bot.sendMessage(chatId, `🔇 Đã cấm khẩu (${mins ? `${mins} phút` : "Vĩnh viễn"})!`);
  } else if (cmd === "/khaitro") {
    const { target } = resolveTarget(m);
    if (!target) return bot.sendMessage(chatId, "💡 Cú pháp: `/khaitro @user`");
    await bot.restrictChatMember(chatId, Number(target), {
      can_send_messages: true,
      can_send_media_messages: true,
      can_send_other_messages: true,
      can_add_web_page_previews: true
    });
    bot.sendMessage(chatId, "🔊 Đã khai khẩu cho đối tượng!");
  } else if (cmd === "/trutxuat") {
    const { target } = resolveTarget(m);
    if (!target || isAdm(target)) return;
    await bot.banChatMember(chatId, Number(target));
    await bot.unbanChatMember(chatId, Number(target));
    bot.sendMessage(chatId, "👢 Đã trục xuất kẻ bại trận!");
  } else if (cmd === "/phongsat") {
    const { target } = resolveTarget(m);
    if (!target || isAdm(target)) return;
    await bot.banChatMember(chatId, Number(target));
    bot.sendMessage(chatId, "🚫 Đã phong sát vĩnh viễn mục tiêu!");
  }

  // HỆ THỐNG MÃ BẢN QUYỀN
  else if (cmd === "/capma") {
    if (!isAdm(uid)) return;
    const p = text.split(/\s+/);
    if (p.length < 3) return bot.sendMessage(chatId, "💡 Cú pháp: `/capma <ngày> <số_máy>`");
    const days = parseInt(p[1], 10);
    const devs = parseInt(p[2], 10);
    const k = genKey();
    db.keys[k] = { days, devs, users: [], created: new Date().toISOString(), by: uid };
    saveDb(db);
    bot.sendMessage(chatId, `🔑 *MÃ ĐÃ TẠO BỞI ANH KHÔI!*\n\`${k}\`\n📅 ${days} ngày | 💻 ${devs} máy`);
  } else if (cmd === "/nhapma") {
    const p = text.split(/\s+/);
    if (p.length < 2) return bot.sendMessage(chatId, "💡 Cú pháp: `/nhapma <KEY>`");
    const k = p[1].toUpperCase();
    if (!db.keys[k]) return bot.sendMessage(chatId, "❌ Mã không hợp lệ!");
    const kd = db.keys[k];
    if (kd.users.includes(uid)) return bot.sendMessage(chatId, "ℹ️ Bạn đã kích hoạt mã này trước đó!");
    if (kd.users.length >= kd.devs) return bot.sendMessage(chatId, "❌ Mã đã hết lượt sử dụng!");
    const exp = new Date(Date.now() + kd.days * 86400000);
    db.users[uid] = exp.toISOString();
    kd.users.push(uid);
    saveDb(db);
    bot.sendMessage(chatId, `✅ *KÍCH HOẠT THÀNH CÔNG!*\n📅 Thời hạn: ${exp.toLocaleString("vi-VN")}`);
  }
}

// ==================== HTTP SERVER GIỮ RENDER 24/7 ====================
function startHttpServer() {
  const server = http.createServer((req, res) => {
    res.writeHead(200, { "Content-Type": "text/plain; charset=utf-8" });
    res.end(`${BOT_NAME}\nSTATUS: ONLINE 24/7 ON RENDER\nAUTHOR: PHAM ANH KHOI\nTOTAL CORPUS: ${memoryCorpus.length}`);
  });

  server.listen(PORT, HOST, () => {
    console.log(`[HTTP SERVER] Đã mở cổng Render tại http://${HOST}:${PORT}`);
  });
}

